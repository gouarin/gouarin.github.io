---
import { arrow, circle, line, rng } from '../lib/sketch';

interface Props {
  subject: 'samurai' | 'scopi' | 'pylbm' | 'devenv' | 'packaging' | 'harness' | 'board' | 'sheet' | 'stack';
  label?: string;
}

const { subject, label } = Astro.props;
const small = subject === 'board' || subject === 'sheet' || subject === 'stack';

type Drawing = { strokes: string[]; heavy: string[]; hatch: string[]; faint: string[] };
const d: Drawing = { strokes: [], heavy: [], hatch: [], faint: [] };

if (subject === 'samurai') {
  // Adaptive mesh refinement: a quadtree refined wherever cells cross a circular front.
  const r = rng(7);
  const X = 65, Y = 15, S = 190;
  const cx = X, cy = Y + S, R = 150;
  const crosses = (x: number, y: number, s: number) => {
    const nx = Math.max(x, Math.min(cx, x + s));
    const ny = Math.max(y, Math.min(cy, y + s));
    const near = Math.hypot(nx - cx, ny - cy);
    const far = Math.max(
      Math.hypot(x - cx, y - cy),
      Math.hypot(x + s - cx, y - cy),
      Math.hypot(x - cx, y + s - cy),
      Math.hypot(x + s - cx, y + s - cy),
    );
    return near < R && far > R;
  };
  const split = (x: number, y: number, s: number, level: number) => {
    if (level < 4 && crosses(x, y, s)) {
      const h = s / 2;
      d.strokes.push(line(r, x + h, y, x + h, y + s, 0.9), line(r, x, y + h, x + s, y + h, 0.9));
      split(x, y, h, level + 1);
      split(x + h, y, h, level + 1);
      split(x, y + h, h, level + 1);
      split(x + h, y + h, h, level + 1);
    } else if (level === 4) {
      d.hatch.push(`M${x} ${y}h${s}v${s}h${-s}Z`);
    }
  };
  d.strokes.push(
    line(r, X, Y, X + S, Y),
    line(r, X + S, Y, X + S, Y + S),
    line(r, X + S, Y + S, X, Y + S),
    line(r, X, Y + S, X, Y),
  );
  split(X, Y, S, 0);
  let arc = '';
  for (let i = 0; i <= 24; i++) {
    const a = -Math.PI / 2 + (Math.PI / 2) * (i / 24);
    const x = cx + Math.cos(a) * (R + (r() - 0.5) * 1.6);
    const y = cy + Math.sin(a) * (R + (r() - 0.5) * 1.6);
    arc += `${i === 0 ? 'M' : 'L'}${x.toFixed(1)} ${y.toFixed(1)}`;
  }
  d.heavy.push(arc);
}

if (subject === 'scopi') {
  // Interacting particles: a pile of spheres in contact, and one more falling onto it.
  const r = rng(11);
  const rad = 16.5;
  const ground = 198;
  d.strokes.push(line(r, 28, ground, 292, ground, 1.5));
  for (let x = 34; x < 290; x += 11) d.faint.push(line(r, x, ground + 3, x - 8, ground + 12, 0.4));
  const centers: [number, number][] = [];
  for (let row = 0; row < 5; row++) {
    const n = 6 - row;
    const y = ground - rad - row * rad * Math.sqrt(3);
    for (let i = 0; i < n; i++) {
      const x = 150 - (n - 1) * rad + i * 2 * rad;
      centers.push([x, y]);
      d.strokes.push(circle(r, x, y, rad - 0.6));
    }
  }
  for (let a = 0; a < centers.length; a++)
    for (let b = a + 1; b < centers.length; b++) {
      const [x1, y1] = centers[a];
      const [x2, y2] = centers[b];
      if (Math.hypot(x2 - x1, y2 - y1) < 2 * rad + 1) d.heavy.push(circle(r, (x1 + x2) / 2, (y1 + y2) / 2, 1.3, 0.2));
    }
  const fx = 236, fy = 58;
  d.hatch.push(`M${fx - rad} ${fy}a${rad} ${rad} 0 1 0 ${2 * rad} 0a${rad} ${rad} 0 1 0 ${-2 * rad} 0Z`);
  d.strokes.push(circle(r, fx, fy, rad));
  d.strokes.push(...arrow(r, fx - 14, fy + 22, fx - 38, fy + 58, 8));
  d.faint.push(line(r, fx + 8, fy - 30, fx + 20, fy - 48, 0.5), line(r, fx + 20, fy - 26, fx + 32, fy - 44, 0.5));
}

if (subject === 'pylbm') {
  // Lattice Boltzmann D2Q9: nine discrete velocities around a lattice node.
  const r = rng(5);
  const c = [160, 112];
  const h = 72;
  for (const k of [-1, 0, 1]) {
    d.faint.push(line(r, c[0] + k * h, c[1] - h - 22, c[0] + k * h, c[1] + h + 22, 0.8));
    d.faint.push(line(r, c[0] - h - 30, c[1] + k * h, c[0] + h + 30, c[1] + k * h, 0.8));
  }
  for (const i of [-1, 0, 1])
    for (const j of [-1, 0, 1]) {
      if (i === 0 && j === 0) continue;
      const x = c[0] + i * h;
      const y = c[1] + j * h;
      d.strokes.push(circle(r, x, y, 4.2, 0.1));
      const len = Math.hypot(i, j);
      const stop = 10 / len;
      d.strokes.push(...arrow(r, c[0] + (i * 14) / len, c[1] + (j * 14) / len, x - i * stop, y - j * stop, 8));
    }
  d.hatch.push(`M${c[0] - 10} ${c[1]}a10 10 0 1 0 20 0a10 10 0 1 0 -20 0Z`);
  d.heavy.push(circle(r, c[0], c[1], 10, 0.05));
}
const rect = (r: ReturnType<typeof rng>, x: number, y: number, w: number, h: number) => [
  line(r, x, y, x + w, y, 0.6),
  line(r, x + w, y, x + w, y + h, 0.6),
  line(r, x + w, y + h, x, y + h, 0.6),
  line(r, x, y + h, x, y, 0.6),
];

const disc = (cx: number, cy: number, rr: number) =>
  `M${cx - rr} ${cy}a${rr} ${rr} 0 1 0 ${2 * rr} 0a${rr} ${rr} 0 1 0 ${-2 * rr} 0Z`;

const gear = (r: ReturnType<typeof rng>, cx: number, cy: number, inner: number, outer: number, teeth: number) => {
  const out: string[] = [circle(r, cx, cy, inner * 0.4, 0.05)];
  for (let k = 0; k < teeth; k++) {
    const a = (k / teeth) * Math.PI * 2;
    const p = (rad: number, da: number) => [cx + Math.cos(a + da) * rad, cy + Math.sin(a + da) * rad] as const;
    const [x1, y1] = p(inner, -0.16);
    const [x2, y2] = p(outer, -0.11);
    const [x3, y3] = p(outer, 0.11);
    const [x4, y4] = p(inner, 0.16);
    const [x5, y5] = p(inner, (Math.PI * 2) / teeth - 0.16);
    out.push(line(r, x1, y1, x2, y2, 0.2), line(r, x2, y2, x3, y3, 0.2), line(r, x3, y3, x4, y4, 0.2));
    out.push(line(r, x4, y4, x5, y5, 0.3));
  }
  return out;
};

if (subject === 'devenv') {
  // Development workflow: a Git history with a feature branch merged back, kept in motion by automation.
  const r = rng(51);
  const y = 150;
  d.strokes.push(line(r, 26, y, 294, y, 1.2));
  for (const x of [48, 96, 238, 280]) d.strokes.push(circle(r, x, y, 8.5));
  d.strokes.push(line(r, 104, y - 5, 128, 104, 0.8), line(r, 128, 104, 208, 104, 1), line(r, 208, 104, 231, y - 5, 0.8));
  for (const x of [148, 190]) {
    d.hatch.push(disc(x, 104, 9));
    d.strokes.push(circle(r, x, 104, 9));
  }
  d.heavy.push(line(r, 225, 128, 232, 136, 0.2), line(r, 232, 136, 246, 118, 0.3));
  d.strokes.push(...gear(r, 250, 58, 20, 28, 9));
  d.faint.push(...arrow(r, 222, 66, 190, 92, 6));
}

if (subject === 'packaging') {
  // Packaging: modules dropped into an open box, ready to ship.
  const r = rng(61);
  const A = [160, 200], B = [92, 166], C = [228, 166];
  const At = [160, 132], Bt = [92, 98], Ct = [228, 98], Dt = [160, 64];
  d.hatch.push(`M${A[0]} ${A[1]}L${C[0]} ${C[1]}L${Ct[0]} ${Ct[1]}L${At[0]} ${At[1]}Z`);
  const seg = (p: number[], q: number[], w = 0.8) => line(r, p[0], p[1], q[0], q[1], w);
  d.strokes.push(seg(B, A), seg(A, C), seg(B, Bt), seg(A, At), seg(C, Ct), seg(Bt, At), seg(At, Ct), seg(Bt, Dt), seg(Dt, Ct));
  d.strokes.push(seg(Bt, [64, 60]), seg([64, 60], [134, 28]), seg([134, 28], Dt, 0.6));
  d.strokes.push(seg(Ct, [258, 62], 0.6), seg([258, 62], [190, 30]), seg([190, 30], Dt, 0.6));
  for (const [x, yy, s] of [[26, 34, 16], [48, 10, 13], [18, 72, 12]] as const) d.strokes.push(...rect(r, x, yy, s, s));
  d.faint.push(...arrow(r, 60, 50, 118, 86, 7));
}

if (subject === 'harness') {
  // Harness: a model held at the centre, tethered to its tools inside one frame.
  const r = rng(71);
  const dash = (x1: number, y1: number, x2: number, y2: number) => {
    const n = Math.round(Math.hypot(x2 - x1, y2 - y1) / 14);
    for (let i = 0; i < n; i++) {
      const t0 = i / n, t1 = (i + 0.55) / n;
      d.faint.push(line(r, x1 + (x2 - x1) * t0, y1 + (y2 - y1) * t0, x1 + (x2 - x1) * t1, y1 + (y2 - y1) * t1, 0.2));
    }
  };
  dash(28, 18, 292, 18);
  dash(292, 18, 292, 202);
  dash(292, 202, 28, 202);
  dash(28, 202, 28, 18);
  const c = [160, 110];
  const tools = [[52, 40], [232, 40], [52, 150], [232, 150]] as const;
  for (const [x, y] of tools) {
    const tx = x + 18, ty = y + 15;
    const len = Math.hypot(tx - c[0], ty - c[1]);
    const ux = (tx - c[0]) / len, uy = (ty - c[1]) / len;
    const edge = Math.min(18 / Math.abs(ux), 15 / Math.abs(uy));
    d.strokes.push(line(r, c[0] + ux * 30, c[1] + uy * 30, tx - ux * edge, ty - uy * edge, 1.4));
    d.strokes.push(...rect(r, x, y, 36, 30));
  }
  d.heavy.push(line(r, 60, 50, 67, 55, 0.2), line(r, 67, 55, 60, 60, 0.2));
  d.strokes.push(line(r, 71, 61, 80, 61, 0.2));
  for (const yy of [48, 55, 62]) d.strokes.push(line(r, 240, yy, yy === 62 ? 254 : 260, yy, 0.2));
  d.strokes.push(...gear(r, 70, 165, 7, 10, 7));
  d.strokes.push(...rect(r, 243, 163, 14, 11), `M${245} ${163}q${5} ${-11} ${10} 0`);
  d.hatch.push(disc(c[0], c[1], 26));
  d.heavy.push(circle(r, c[0], c[1], 26, 0.04));
}

if (subject === 'board') {
  // Training: a board on an easel, a few lines of notes and one hatched figure.
  const r = rng(21);
  d.strokes.push(...rect(r, 20, 22, 80, 54));
  d.strokes.push(line(r, 44, 76, 34, 104, 0.5), line(r, 76, 76, 86, 104, 0.5), line(r, 60, 76, 60, 98, 0.5));
  d.faint.push(line(r, 28, 34, 62, 34, 0.5), line(r, 28, 44, 56, 44, 0.5), line(r, 28, 54, 60, 54, 0.5));
  d.hatch.push('M68 32h24v34h-24Z');
  d.strokes.push(...rect(r, 68, 32, 24, 34));
}

if (subject === 'sheet') {
  // CV: one page with a folded corner, a hatched portrait and lines of text.
  const r = rng(31);
  d.strokes.push(
    line(r, 32, 16, 76, 16, 0.5),
    line(r, 76, 16, 90, 30, 0.4),
    line(r, 90, 30, 90, 104, 0.5),
    line(r, 90, 104, 32, 104, 0.5),
    line(r, 32, 104, 32, 16, 0.5),
    line(r, 76, 16, 76, 30, 0.3),
    line(r, 76, 30, 90, 30, 0.3),
  );
  d.hatch.push('M40 26h16v18h-16Z');
  d.strokes.push(...rect(r, 40, 26, 16, 18));
  for (const y of [54, 64, 74, 84, 94]) d.faint.push(line(r, 40, y, y === 94 ? 64 : 82, y, 0.4));
}

if (subject === 'stack') {
  // Publications: a small stack of papers, the top one with a hatched title band.
  const r = rng(41);
  d.faint.push(...rect(r, 40, 12, 56, 78));
  d.strokes.push(...rect(r, 32, 20, 56, 78));
  d.strokes.push(...rect(r, 24, 28, 56, 78));
  d.hatch.push('M31 36h42v10h-42Z');
  for (const y of [58, 67, 76, 85, 94]) d.faint.push(line(r, 31, y, y === 94 ? 56 : 73, y, 0.4));
}
---

<svg
  class:list={['sketch', { 'sketch-small': small }]}
  viewBox={small ? '0 0 120 120' : '0 0 320 220'}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <g filter="url(#pencil)">
    {d.hatch.map((p) => <path class="hatch" d={p} />)}
    {d.faint.map((p) => <path class="ln faint" d={p} pathLength="1" />)}
    {d.strokes.map((p) => <path class="ln" d={p} pathLength="1" />)}
    {d.heavy.map((p) => <path class="ln heavy" d={p} pathLength="1" />)}
  </g>
</svg>
