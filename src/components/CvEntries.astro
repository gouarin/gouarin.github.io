---
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  id: string;
  title: string;
  entries: CollectionEntry<'cvExperience' | 'cvEducation' | 'cvProjects'>[];
}

const { id, title, entries } = Astro.props;
const rows = await Promise.all(
  entries.map(async (e) => ({ ...e.data, hasBody: Boolean(e.body?.trim()), Content: (await render(e)).Content })),
);
---

<section class="cv-section" aria-labelledby={`cv-${id}`}>
  <h2 id={`cv-${id}`}>{title}</h2>
  <ol class="cv-rows">
    {
      rows.map((e) => (
        <li class="cv-row">
          <p class="cv-when">{e.dates}</p>
          <div>
            <h3>{e.url ? <a href={e.url}>{e.org}</a> : e.org}</h3>
            <p class="cv-sub">
              {e.position}
              {e.location ? <> · {e.location}</> : <span class="cv-url"> · {e.url?.replace(/^https?:\/\//, '')}</span>}
            </p>
            {e.hasBody ? (
              <div class="cv-body prose">
                <e.Content />
              </div>
            ) : null}
          </div>
        </li>
      ))
    }
  </ol>
</section>
