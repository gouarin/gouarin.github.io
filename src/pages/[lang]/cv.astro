---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CvEntries from '../../components/CvEntries.astro';
import { assetHref, cvHref, langs, otherLang, ui, type Lang } from '../../i18n';
import { cv, tr, type Honor } from '../../lib/cv';
import { publications } from '../../data/publications';
import avatar from '../../assets/loic_small.png';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = ui[lang];
const h = cv.header;
const fullName = `${h.firstName} ${h.lastName}`;

const contacts = [
  { label: h.email, href: `mailto:${h.email}` },
  { label: `github.com/${h.github}`, href: `https://github.com/${h.github}` },
  { label: `linkedin.com/in/${h.linkedin}`, href: `https://www.linkedin.com/in/${h.linkedin}` },
  { label: `x.com/${h.x}`, href: `https://x.com/${h.x}` },
];

---

<Base lang={lang} title={`${t.cv}, ${fullName}`} description={`${t.cv}, ${fullName}: ${tr(h.position, lang)}.`} alternate={cvHref(otherLang(lang))}>
  <article class="wrap cv">
    <header class="cv-head">
      <Image src={avatar} alt="" width={120} height={121} class="cv-portrait" loading="eager" />
      <div>
        <h1>{fullName}</h1>
        <p class="role"><mark>{tr(h.position, lang)}</mark></p>
        <ul class="cv-contacts">
          {contacts.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
        </ul>
      </div>
      <p class="cv-downloads">
        <a class="cv-download" href={assetHref(`cv/loic-gouarin-cv-${lang}.pdf`)}>
          {t.cvPdfClassic}
          <svg class="out" viewBox="0 0 12 12" aria-hidden="true"><path d="M6 2.5v6M3.5 6 6 8.5 8.5 6M3 10h6" /></svg>
        </a>
        <a class="cv-download" href={assetHref(`cv/loic-gouarin-cv-web-${lang}.pdf`)}>
          {t.cvPdfWeb}
          <svg class="out" viewBox="0 0 12 12" aria-hidden="true"><path d="M6 2.5v6M3.5 6 6 8.5 8.5 6M3 10h6" /></svg>
        </a>
      </p>
    </header>

    <CvEntries id="experience" title={tr(cv.experience.title, lang)} entries={cv.experience.entries} lang={lang} />

    <section class="cv-section" aria-labelledby="cv-skills">
      <h2 id="cv-skills">{tr(cv.skills.title, lang)}</h2>
      <dl class="cv-skills">
        {
          cv.skills.entries.map((s) => (
            <div>
              <dt>{tr(s.type, lang)}</dt>
              <dd>{tr(s.set, lang)}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <CvEntries id="education" title={tr(cv.education.title, lang)} entries={cv.education.entries} lang={lang} />

    <CvEntries id="projects" title={tr(cv.projects.title, lang)} entries={cv.projects.entries} lang={lang} />

    <section class="cv-section" aria-labelledby="cv-activities">
      <h2 id="cv-activities">{tr(cv.activities.title, lang)}</h2>
      <ol class="cv-lines">
        {
          cv.activities.entries.map((a: Honor) => (
            <li class="cv-line">
              <span class="cv-when">{tr(a.dates, lang)}</span>
              <span>
                <strong>{tr(a.position, lang)}</strong>, {tr(a.title, lang)}
              </span>
              <span class="cv-where">{tr(a.location, lang)}</span>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="cv-section" aria-labelledby="cv-teaching">
      <h2 id="cv-teaching">{tr(cv.teaching.title, lang)}</h2>
      {
        cv.teaching.groups.map((g) => (
          <>
            <h3 class="cv-group">{tr(g.title, lang)}</h3>
            <ol class="cv-lines">
              {g.entries.map((a) => (
                <li class="cv-line">
                  <span class="cv-when">{tr(a.dates, lang)}</span>
                  <span>
                    <strong>{tr(a.position, lang)}</strong>, {a.url ? <a href={a.url}>{tr(a.title, lang)}</a> : tr(a.title, lang)}
                  </span>
                  <span class="cv-where">{tr(a.location, lang)}</span>
                </li>
              ))}
            </ol>
          </>
        ))
      }
    </section>

    <section class="cv-section" aria-labelledby="cv-publications">
      <h2 id="cv-publications">{tr(cv.publications.title, lang)}</h2>
      <ol class="cv-rows">
        {
          publications.map((p) => (
            <li class="cv-row" lang="en">
              <p class="cv-when">{p.year}</p>
              <div>
                <h3 class="cv-paper">{p.doi ? <a href={p.doi}>{p.title}</a> : p.title}</h3>
                <p class="cv-sub">
                  {p.authors.map((a, i) => (
                    <>
                      {a.self ? <strong>{a.name}</strong> : a.name}
                      {i < p.authors.length - 1 ? ', ' : ''}
                    </>
                  ))}
                </p>
                {p.venue ? <p class="cv-venue">{p.venue}</p> : null}
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="cv-section" aria-labelledby="cv-hobbies">
      <h2 id="cv-hobbies">{tr(cv.hobbies.title, lang)}</h2>
      <p class="cv-para">{tr(cv.hobbies.text, lang)}</p>
    </section>
  </article>
</Base>
