---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CvEntries from '../../components/CvEntries.astro';
import { assetHref, cvHref, langs, otherLang, ui, type Lang } from '../../i18n';
import { entries, single } from '../../lib/content';
import { publications } from '../../data/publications';
import avatar from '../../assets/loic_small.png';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = ui[lang];
const titles = t.cvSections;
const h = (await single('profile', lang)).data;
const fullName = `${h.givenName} ${h.familyName}`;
const skills = await Promise.all(
  (await entries('cvSkills', lang)).map(async (s) => ({ title: s.data.title, Content: (await render(s)).Content })),
);
const activities = await entries('cvActivities', lang);
const teaching = await entries('cvTeaching', lang);
const teachingGroups = [
  { title: titles.teachingInitial, entries: teaching.filter((e) => e.data.group === 'initial') },
  { title: titles.teachingContinuing, entries: teaching.filter((e) => e.data.group === 'continuing') },
];
const { Content: Hobbies } = await render(await single('cvHobbies', lang));
const experience = await entries('cvExperience', lang);
const education = await entries('cvEducation', lang);
const projects = await entries('cvProjects', lang);

const contacts = [
  { label: h.email, href: `mailto:${h.email}` },
  { label: `github.com/${h.github}`, href: `https://github.com/${h.github}` },
  { label: `linkedin.com/in/${h.linkedin}`, href: `https://www.linkedin.com/in/${h.linkedin}` },
  { label: `x.com/${h.x}`, href: `https://x.com/${h.x}` },
];
---

<Base lang={lang} title={`${t.cv}, ${fullName}`} description={`${t.cv}, ${fullName}: ${h.role}.`} alternate={cvHref(otherLang(lang))}>
  <article class="wrap cv">
    <header class="cv-head">
      <Image src={avatar} alt="" width={120} height={121} class="cv-portrait" loading="eager" />
      <div>
        <h1>{fullName}</h1>
        <p class="role"><mark>{h.role}</mark></p>
        <ul class="cv-contacts">
          {contacts.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
        </ul>
      </div>
      <p class="cv-downloads">
        <a class="cv-download" href={assetHref(`cv/loic-gouarin-cv-${lang}.pdf`)}>
          {t.cvPdfClassic}
          <svg class="out" viewBox="0 0 12 12" aria-hidden="true"><path d="M6 2.5v6M3.5 6 6 8.5 8.5 6M3 10h6" /></svg>
        </a>
        <a class="cv-download" href={assetHref(`cv/loic-gouarin-cv-web-${lang}.pdf`)}>
          {t.cvPdfWeb}
          <svg class="out" viewBox="0 0 12 12" aria-hidden="true"><path d="M6 2.5v6M3.5 6 6 8.5 8.5 6M3 10h6" /></svg>
        </a>
      </p>
    </header>

    <CvEntries id="experience" title={titles.experience} entries={experience} />

    <section class="cv-section" aria-labelledby="cv-skills">
      <h2 id="cv-skills">{titles.skills}</h2>
      <dl class="cv-skills">
        {
          skills.map((s) => (
            <div>
              <dt>{s.title}</dt>
              <dd class="prose">
                <s.Content />
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <CvEntries id="education" title={titles.education} entries={education} />

    <CvEntries id="projects" title={titles.projects} entries={projects} />

    <section class="cv-section" aria-labelledby="cv-activities">
      <h2 id="cv-activities">{titles.activities}</h2>
      <ol class="cv-lines">
        {
          activities.map(({ data: a }) => (
            <li class="cv-line">
              <span class="cv-when">{a.dates}</span>
              <span>
                <strong>{a.position}</strong>, {a.url ? <a href={a.url}>{a.title}</a> : a.title}
              </span>
              <span class="cv-where">{a.location}</span>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="cv-section" aria-labelledby="cv-teaching">
      <h2 id="cv-teaching">{titles.teaching}</h2>
      {
        teachingGroups.map((g) => (
          <>
            <h3 class="cv-group">{g.title}</h3>
            <ol class="cv-lines">
              {g.entries.map(({ data: a }) => (
                <li class="cv-line">
                  <span class="cv-when">{a.dates}</span>
                  <span>
                    <strong>{a.position}</strong>, {a.url ? <a href={a.url}>{a.title}</a> : a.title}
                  </span>
                  <span class="cv-where">{a.location}</span>
                </li>
              ))}
            </ol>
          </>
        ))
      }
    </section>

    <section class="cv-section" aria-labelledby="cv-publications">
      <h2 id="cv-publications">{titles.publications}</h2>
      <ol class="cv-rows">
        {
          publications.map((p) => (
            <li class="cv-row" lang="en">
              <p class="cv-when">{p.year}</p>
              <div>
                <h3 class="cv-paper">{p.doi ? <a href={p.doi}>{p.title}</a> : p.title}</h3>
                <p class="cv-sub">
                  {p.authors.map((a, i) => (
                    <>
                      {a.self ? <strong>{a.name}</strong> : a.name}
                      {i < p.authors.length - 1 ? ', ' : ''}
                    </>
                  ))}
                </p>
                {p.venue ? <p class="cv-venue">{p.venue}</p> : null}
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="cv-section" aria-labelledby="cv-hobbies">
      <h2 id="cv-hobbies">{titles.hobbies}</h2>
      <div class="cv-body prose">
        <Hobbies />
      </div>
    </section>
  </article>
</Base>
